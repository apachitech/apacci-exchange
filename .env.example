# ==============================================================================
# Apacci Exchange — Environment Variables (.env.example)
# Copy to .env.local for local development. NEVER commit .env.local to Git.
# ==============================================================================

# App Base URL (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase Public Configuration (safe for client & server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (SERVER ONLY — bypasses RLS for webhooks, cron, and admin actions)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# SasPay API Configuration (SERVER ONLY — never expose to client)
SASPAY_BASE_URL=https://api.saspay.me/api/v1
# Use sk_test_... for sandbox/development, sk_live_... for production
SASPAY_SECRET_KEY=sk_test_replace_with_your_saspay_secret_key
# Webhook signing secret shown ONCE when creating/rotating webhook in app.saspay.me
SASPAY_WEBHOOK_SECRET=whsec_replace_with_your_saspay_webhook_signing_secret

# Vercel Cron Secret (SERVER ONLY — protects /api/cron/reconcile)
CRON_SECRET=replace_with_a_long_random_hex_secret_min_32_chars

